{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "read_only_verification",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "agent",
    "phase",
    "status",
    "paths",
    "allowed_write_roots",
    "checks",
    "violations",
    "source_modified",
    "artifact_refs"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "run_id": {"type": "string", "minLength": 1},
    "agent": {"type": "string", "enum": ["analysis_agent"]},
    "phase": {"type": "string", "enum": ["analysis"]},
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "paths": {
      "type": "object",
      "required": ["legacy_root", "modernized_root", "artifact"],
      "properties": {
        "legacy_root": {"type": "string", "minLength": 1},
        "modernized_root": {"type": "string", "minLength": 1},
        "artifact": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "allowed_write_roots": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "checks": {
      "type": "object",
      "required": ["legacy_tree_unchanged", "modernized_source_unchanged", "ignored_generated_paths"],
      "properties": {
        "legacy_tree_unchanged": {"type": "boolean"},
        "modernized_source_unchanged": {"type": "boolean"},
        "ignored_generated_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tree", "path", "change_type"],
        "properties": {
          "tree": {"type": "string", "enum": ["legacy", "modernized"]},
          "path": {"type": "string", "minLength": 1},
          "change_type": {"type": "string", "enum": ["added", "modified", "deleted"]}
        },
        "additionalProperties": false
      }
    },
    "source_modified": {"type": "boolean"},
    "artifact_refs": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": true
}
