{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema_version", "run_id", "failure_type", "severity", "migration_blocker", "security_env_warning", "likely_root_cause", "evidence", "recommended_next_step", "send_to_copilot", "requires_human_review"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string"},
    "failure_type": {"type": "string"},
    "severity": {"enum": ["INFO", "WARNING", "BLOCKER", "UNKNOWN"]},
    "migration_blocker": {"type": "boolean"},
    "security_env_warning": {"type": "boolean"},
    "likely_root_cause": {"type": "string"},
    "evidence": {"type": "array"},
    "recommended_next_step": {"type": "string"},
    "send_to_copilot": {"type": "boolean"},
    "requires_human_review": {"type": "boolean"}
  },
  "additionalProperties": true
}
