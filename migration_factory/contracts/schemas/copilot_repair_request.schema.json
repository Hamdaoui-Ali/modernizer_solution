  "type": "object",
  "required": ["schema_version", "run_id", "mode", "failure_classification", "guardrails"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string"},
    "mode": {"const": "proposal_only"},
    "failure_classification": {"type": "object"},
    "openrewrite_diff_safety": {"type": "object"},
    "h2_startup_report": {"type": "object"},
    "artifact_refs": {"type": "object"},
    "guardrails": {"type": "object"}
  },
  "additionalProperties": true
}
