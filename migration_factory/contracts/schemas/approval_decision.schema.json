{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "approval_decision",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "agent",
    "phase",
    "decision",
    "decided_by",
    "decided_at",
    "artifact_refs"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "run_id": {"type": "string", "minLength": 1},
    "agent": {"type": "string", "enum": ["human"]},
    "phase": {"type": "string", "enum": ["approval"]},
    "decision": {
      "type": "string",
      "enum": ["approved", "rejected", "replan_required"]
    },
    "decided_by": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "minLength": 1},
    "comments": {"type": "string"},
    "plan_lock_ref": {"type": ["string", "null"], "minLength": 1},
    "artifact_refs": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": true
}
