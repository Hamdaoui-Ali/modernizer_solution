{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "copilot_report_response",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "provider",
    "model",
    "status",
    "fallback_used",
    "output_ref",
    "validation",
    "warnings"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "run_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": ["string", "null"]},
    "status": {"type": "string", "enum": ["generated", "generated_with_fallback", "failed"]},
    "fallback_used": {"type": "boolean"},
    "output_ref": {"type": ["string", "null"]},
    "validation": {
      "type": "object",
      "additionalProperties": {"type": ["string", "boolean", "number", "object", "array", "null"]}
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
